<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TaskPrioMemory</AssemblyName>
    <RootNamespace>TaskPrioMemory</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Company>Eyad</Company>
    <Product>Task Priority Memory</Product>
    <!-- Keep the footprint tiny -->
    <TieredCompilation>false</TieredCompilation>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- Lets `dotnet build` target .NET Framework 4.8 even where the targeting
       pack isn't installed (e.g. clean CI agents). Build-time only. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
